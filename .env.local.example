# ============================================================
#  Supabase (obligatorio)
# ============================================================
# Crea un proyecto en https://supabase.com y copia estos valores
# desde Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio (SOLO servidor, NUNCA expone el frontend)
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
#  Encriptacion de tokens de Gmail (AES-GCM).
#  Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#  Si esta vacia, se deriva de SUPABASE_SERVICE_ROLE_KEY (menos seguro).
# ============================================================
ENCRYPTION_KEY=

# ============================================================
#  Google OAuth (para Gmail)
# ============================================================
# Crea credenciales OAuth 2.0 en https://console.cloud.google.com
# 1. Crear proyecto
# 2. Habilitar la API de Gmail
# 3. OAuth consent screen -> External
# 4. Credentials -> Create credentials -> OAuth client ID -> Web app
#    Autorized redirect URIs:
#      http://localhost:3000/api/gmail/callback
#    (y la URL de producción si la tienes)
# 5. Copia el Client ID y Client Secret aqui
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL base de la app (sin barra final). Ej: http://localhost:3000
APP_URL=http://localhost:3000

# ============================================================
#  Opcional: extraccion avanzada con un LLM.
#  Sin esta clave el sistema usa extraccion por regex/HTML,
#  que funciona para la mayoria de productos de AliExpress.
# ============================================================
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ============================================================
#  Opcional: proxy de lectura para paginas bloqueadas.
#  Sin clave, la extraccion usara Jina Reader publico
#  (https://r.jina.ai) y fallara limpio si no es accesible.
# ============================================================
# JINA_API_KEY=